# Student Hub API Configuration
# Note: On macOS, port 5000 is reserved by macOS ControlCenter (AirPlay Receiver).
# Default to port 5001 for seamless macOS Apple Silicon operation.
PORT=5001
NODE_ENV=development
CLIENT_ORIGIN=http://localhost:5173

